# ─── NutriGen — Variáveis de Ambiente ──────────────
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o arquivo .env real no Git.

# ─── DeepSeek API (OBRIGATÓRIO) ────────────────────
DEEPSEEK_API_KEY=sk-sua-chave-aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_RETRIES=2

# Timeouts específicos (segundos)
EXTRACTION_TIMEOUT=15
GENERATION_TIMEOUT=90

# ─── JWT (OBRIGATÓRIO) ─────────────────────────────
# Gere uma chave aleatória com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=substitua-por-chave-aleatoria-de-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ─── Banco de Dados ────────────────────────────────
# SQL Server Express com Windows Authentication
# Deixe vazio para usar a connection string padrão (local)
DATABASE_URL=

# ─── Rate Limiting ─────────────────────────────────
RATE_LIMIT_ANON=10
RATE_LIMIT_AUTH=30
RATE_LIMIT_HOUR_ANON=50
RATE_LIMIT_HOUR_AUTH=200

# ─── Custos e Segurança ────────────────────────────
MAX_DAILY_COST_BRL=50.00
# IPs banidos separados por vírgula (deixe vazio para nenhum)
BANNED_IPS=

# ─── Aplicação ─────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# ─── Prompts (SPEC-044) ────────────────────────────
# Versão dos system prompts a carregar de prompts/
# Arquivos: prompts/extraction_{version}.txt, prompts/generation_{version}.txt
PROMPT_VERSION=v1
